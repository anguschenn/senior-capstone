# Backend environment template. Copy to python/.env and fill in.
# Every variable here is read by python/config.py; nothing else is.
# On Render, set the same names under the service's Environment tab.

# ---------------------------------------------------------------
# Plaid  —  dashboard.plaid.com → Team → Keys
# ---------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox | production  ("development" was retired by Plaid in 2024).
# This project runs production only (Trial plan: 10 Items, a linked Item is
# consumed on /api/set_access_token and never refunded).
PLAID_ENV=production

# Comma-separated Plaid products to request.
PLAID_PRODUCTS=transactions,auth

# Comma-separated ISO country codes.
PLAID_COUNTRY_CODES=US

# Leave EMPTY for web. Desktop web opens OAuth banks in a popup and never uses
# it. Only native iOS (a universal link) and webviews need one.
PLAID_REDIRECT_URI=

# Public HTTPS URL Plaid POSTs webhooks to. New link tokens carry it; register
# existing Items with: python scripts/set_item_webhooks.py --apply
PLAID_WEBHOOK_URL=https://senior-capstone-x2ar.onrender.com/plaid/webhook

# ---------------------------------------------------------------
# Supabase  —  dashboard → Project Settings → API
# ---------------------------------------------------------------
SUPABASE_URL=
# service_role / secret key. Backend only; NEVER put it in the Flutter .env.
SUPABASE_KEY=
# Not read yet: planned for local JWT verification (Track A, weeks 1-2).
# SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------
# Backend auth and CORS
# ---------------------------------------------------------------
# Shared secret checked on every /api/* request. Must equal BACKEND_API_KEY in
# ssdemo_1/.env. Required: the API returns 500 without it.
INTERNAL_API_KEY=

# Comma-separated browser origins allowed to call /api/*. "http://localhost:*"
# allows any localhost port (flutter run -d chrome picks a random one); a
# wildcard is only accepted as the whole port. Add the hosted web app's origin
# when it exists. Empty blocks every browser client.
ALLOWED_ORIGINS=http://localhost:*

# ---------------------------------------------------------------
# AI layer
# ---------------------------------------------------------------
# openrouter | ollama. The name is AI_PROVIDER (LLM_PROVIDER is read by nothing
# and silently falls back to Ollama on 127.0.0.1).
AI_PROVIDER=openrouter

OPENROUTER_API_KEY=
# The name is OPENROUTER_MODEL (not LLM_MODEL). The previous free model
# meta-llama/llama-3.1-8b-instruct:free was retired and returns 404; the paid
# model below needs OpenRouter credit. Model choice is still being decided.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers sent to OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Only used when AI_PROVIDER=ollama.
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://127.0.0.1:11434

# 1 = v2 chat router (default); 0 rolls back to the v1 path.
AI_ROUTER_V2_ENABLED=1

# Per-IP AI requests per minute (in-memory, single worker).
AI_RATE_LIMIT_PER_MINUTE=12
# Largest accepted AI request body, in bytes.
AI_MAX_REQUEST_BYTES=16384
# How long the per-user AI spending snapshot is cached.
SPENDING_SNAPSHOT_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------
# Server metadata (Render sets PORT itself)
# ---------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
# development | production
ENV=development
APP_VERSION=
GIT_SHA=
